{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustworthy:draft-argument:0.1.0",
  "title": "DraftArgument output contract for the unresolved fixture profile",
  "description": "Accepted means structurally accepted draft, never an accepted physical safety claim. The generation driver supplies the run identity and input bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "test_fixture", "request_sha256", "requirement_configuration_sha256", "evidence_package_sha256", "generation_status", "argument_bundle", "summary", "limitations", "diagnostics", "validation", "generation_provenance", "empirical_admission_enabled", "safety_claim_verified"],
  "properties": {
    "schema_version": {"const": "draft-argument/0.1.0"},
    "request_id": {"$ref": "#/$defs/text"},
    "test_fixture": {"const": true},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "requirement_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_package_sha256": {"$ref": "#/$defs/sha256"},
    "generation_status": {"enum": ["accepted", "rejected", "failed"]},
    "argument_bundle": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/argument_bundle"}]},
    "summary": {"$ref": "#/$defs/text"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "diagnostics": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {"code": {"$ref": "#/$defs/text"}, "path": {"type": "string"}, "message": {"$ref": "#/$defs/text"}}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["input_schema", "input_semantics", "output_schema", "graph_semantics", "evidence_references", "physical_sufficiency"],
      "properties": {
        "input_schema": {"$ref": "#/$defs/check_status"},
        "input_semantics": {"$ref": "#/$defs/check_status"},
        "output_schema": {"$ref": "#/$defs/check_status"},
        "graph_semantics": {"$ref": "#/$defs/check_status"},
        "evidence_references": {"$ref": "#/$defs/check_status"},
        "physical_sufficiency": {"const": "not_assessed"}
      }
    },
    "generation_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "model_id", "model_revision", "prompt_version", "prompt_sha256", "run_id", "raw_output_sha256"],
      "properties": {
        "backend": {"enum": ["not_run", "local_llm"]},
        "model_id": {"type": ["string", "null"], "minLength": 1},
        "model_revision": {"type": ["string", "null"], "minLength": 1},
        "prompt_version": {"type": ["string", "null"], "minLength": 1},
        "prompt_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "run_id": {"type": ["string", "null"], "minLength": 1},
        "raw_output_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "empirical_admission_enabled": {"const": false},
    "safety_claim_verified": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"generation_status": {"const": "accepted"}}, "required": ["generation_status"]},
      "then": {
        "properties": {
          "argument_bundle": {"$ref": "#/$defs/argument_bundle"},
          "validation": {"properties": {"input_schema": {"const": "passed"}, "input_semantics": {"const": "passed"}, "output_schema": {"const": "passed"}, "graph_semantics": {"const": "passed"}, "evidence_references": {"const": "passed"}}},
          "generation_provenance": {"properties": {"backend": {"const": "local_llm"}, "model_id": {"$ref": "#/$defs/text"}, "prompt_version": {"$ref": "#/$defs/text"}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/text"}, "raw_output_sha256": {"$ref": "#/$defs/sha256"}}}
        }
      },
      "else": {"properties": {"argument_bundle": {"type": "null"}, "diagnostics": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check_status": {"enum": ["passed", "failed", "not_run"]},
    "graph": {
      "allOf": [
        {"$ref": "../../evaluation/r1_v4/evidence_registry_gsn/gsn_graph.schema.json"},
        {"properties": {"nodes": {"minItems": 1, "items": {"allOf": [{"if": {"properties": {"physical_claim": {"const": true}}, "required": ["physical_claim"]}, "then": {"properties": {"type": {"enum": ["goal", "unresolved_claim"]}, "validation_status": {"const": "unresolved"}}}}]}}}}
      ]
    },
    "argument_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_id", "protected_objects", "graphs", "execution_conclusion"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/text"},
        "protected_objects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "graphs": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["object_id", "graph"],
            "properties": {"object_id": {"$ref": "#/$defs/text"}, "graph": {"$ref": "#/$defs/graph"}}
          }
        },
        "execution_conclusion": {
          "type": "object", "additionalProperties": false,
          "required": ["claimed_outcome", "statement", "object_outcomes"],
          "properties": {
            "claimed_outcome": {"const": "insufficient_information"},
            "statement": {"$ref": "#/$defs/text"},
            "object_outcomes": {"type": "object", "minProperties": 1, "additionalProperties": {"const": "insufficient_information"}}
          }
        }
      }
    }
  }
}
