{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustworthy:drafter-local-model:0.1.0",
  "title": "Explicit local model-server connection settings",
  "description": "No model download or deployment. Runtime also validates endpoint authority, finite bounds and disallows paid OpenAI/Azure hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_url", "model_id", "model_revision", "timeout_seconds", "max_tokens", "temperature", "top_p", "seed", "response_format", "api_key_env", "allow_remote_endpoint", "max_response_bytes"],
  "properties": {
    "schema_version": {"const": "drafter-local-model/0.1.0"},
    "base_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "model_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 16384},
    "temperature": {"type": "number", "minimum": 0, "maximum": 2},
    "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
    "response_format": {"enum": ["json_schema", "json_object", "vllm_structured_outputs"]},
    "reasoning_effort": {"enum": [null, "none", "low", "medium", "high"], "description": "Optional explicit server/model-specific setting; omitted means no reasoning-effort parameter is sent."},
    "enable_thinking": {"type": ["boolean", "null"], "description": "Optional explicit vLLM/Qwen chat-template switch; sent through chat_template_kwargs only when configured."},
    "api_key_env": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "allow_remote_endpoint": {"type": "boolean"},
    "max_response_bytes": {"type": "integer", "minimum": 128, "maximum": 4194304}
  }
}
