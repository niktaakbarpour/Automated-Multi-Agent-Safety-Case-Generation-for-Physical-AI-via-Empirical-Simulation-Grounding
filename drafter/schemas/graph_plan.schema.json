{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustworthy:drafter-graph-plan:0.2.2",
  "title": "Intermediate model graph plan, not the final shared GSN graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphs", "summary", "limitations"],
  "properties": {
    "graphs": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["object_id", "root_id", "nodes", "edges"],
        "properties": {
          "object_id": {"$ref": "#/$defs/id"},
          "root_id": {"$ref": "#/$defs/id"},
          "nodes": {
            "type": "array", "minItems": 4, "maxItems": 24,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "type", "statement", "evidence_id", "physical_claim"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "type": {"enum": ["goal", "strategy", "context", "assumption", "justification", "solution", "defeater", "unresolved_claim"]},
                "statement": {"$ref": "#/$defs/text"},
                "evidence_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
                "physical_claim": {"type": "boolean"}
              }
            }
          },
          "edges": {
            "type": "array", "minItems": 2, "maxItems": 80,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "target", "type"],
              "properties": {
                "source": {"$ref": "#/$defs/id"},
                "target": {"$ref": "#/$defs/id"},
                "type": {"enum": ["supported_by", "in_context_of", "challenged_by"]}
              }
            }
          }
        }
      }
    },
    "summary": {"$ref": "#/$defs/text"},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "text": {"type": "string", "minLength": 8, "maxLength": 1600}
  }
}
