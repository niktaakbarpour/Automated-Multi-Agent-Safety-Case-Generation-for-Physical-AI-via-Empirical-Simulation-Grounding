{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustworthy:drafter-operation-rejection:0.1.0",
  "title": "CLI rejection before an operation-specific run is available",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_status", "model_called", "diagnostics"],
  "properties": {
    "schema_version": {"const": "drafter-operation-rejection/0.1.0"},
    "contract_status": {"const": "rejected"},
    "model_called": {"const": false},
    "diagnostics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_write_error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"const": "report_not_saved"}, "message": {"type": "string"}}
    }
  }
}
