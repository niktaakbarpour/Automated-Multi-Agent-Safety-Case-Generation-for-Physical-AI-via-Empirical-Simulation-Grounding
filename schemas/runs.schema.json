{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "task_id",
          "benchmark_outcome",
          "available_measurements",
          "evidence",
          "execution_files"
        ]
      }
    }
  }
}
