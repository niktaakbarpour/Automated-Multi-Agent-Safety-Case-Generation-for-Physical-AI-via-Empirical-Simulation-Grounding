{
  "$id": "urn:trustworthy:critic-request:0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critic review request (one execution)",
  "description": "Sections A-E from the Critic handoff. The Critic enforces this schema at runtime, and also checks each graph against urn:trustworthy:gsn:1.0.0 (plus Graph.validate rules) and each evidence record against urn:trustworthy:registry-record:1.0.0 (plus Record.validate rules). Any failure is reported as a validation-phase criticism and the request is rejected (review_status rejected_invalid_input) without a model review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "test_fixture", "evaluation_context", "argument_bundle", "evidence_package", "checker_assessments", "retrieval_context"],
  "properties": {
    "schema_version": {"const": "critic-request/0.2.0"},
    "request_id": {"type": "string", "minLength": 1},
    "test_fixture": {"type": "boolean", "description": "true when any content is synthetic test data; must never be mixed with real empirical results."},
    "evaluation_context": {
      "description": "Section A. What is being evaluated. Taken from the R1 v2 configuration, never hardcoded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "requirement_version", "execution_id", "benchmark", "task_id", "model_checkpoint", "protected_objects", "support_surfaces", "monitored_interval", "contract_versions"],
      "properties": {
        "requirement_id": {"const": "R1"},
        "requirement_version": {"const": "2.0.0"},
        "requirement_ref": {"type": "string"},
        "execution_id": {"type": "string", "minLength": 1},
        "benchmark": {"type": "string"},
        "task_id": {"type": "string"},
        "variant_id": {
          "type": ["string", "null"],
          "description": "Task variant, or null if there is none. The R1 configuration has no variant field, so a checker result is tied to a variant only through its execution ID."
        },
        "model_checkpoint": {"type": "string"},
        "protected_objects": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "support_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "monitored_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "clock", "interval"],
          "properties": {
            "domain": {"enum": ["frame", "time"]},
            "clock": {"type": "string"},
            "interval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          }
        },
        "contract_versions": {"type": "object"}
      }
    },
    "argument_bundle": {
      "description": "Section B. One GSN 1.0.0 graph per protected object, wrapped with the execution-level conclusion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "protected_objects", "graphs", "execution_conclusion"],
      "properties": {
        "execution_id": {"type": "string"},
        "protected_objects": {"type": "array", "items": {"type": "string"}},
        "graphs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_id", "graph"],
            "properties": {
              "object_id": {"type": "string"},
              "graph": {"type": "object", "description": "urn:trustworthy:gsn:1.0.0"}
            }
          }
        },
        "execution_conclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimed_outcome", "statement", "object_outcomes"],
          "properties": {
            "claimed_outcome": {"enum": ["violation_observed", "no_violation_observed_within_validated_coverage", "not_applicable", "insufficient_information", "invalid_measurement_contract", null]},
            "statement": {"type": "string"},
            "object_outcomes": {
              "type": "object",
              "additionalProperties": {"enum": ["violation_observed", "no_violation_observed_within_validated_coverage", "not_applicable", "insufficient_information", "invalid_measurement_contract"]}
            }
          }
        }
      }
    },
    "evidence_package": {
      "description": "Section C. Records exported from the evidence registry (urn:trustworthy:registry-record:1.0.0). No database access.",
      "type": "object",
      "additionalProperties": false,
      "required": ["records"],
      "properties": {"records": {"type": "array", "items": {"type": "object"}}}
    },
    "checker_assessments": {
      "description": "Section D. R1 checker results: the output of evaluation/r1_v4/runtime.py:assess, unchanged, with the configuration it ran on. The Critic uses an object assessment only if both content hashes, the configuration scope, the object's evidence and the admission rules check out (critic/assessments.py). An empty list means unavailable, never 'no violation'.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configuration", "result"],
        "properties": {
          "configuration": {
            "type": "object",
            "description": "The R1 v2 configuration the checker ran on (requirements/r1_generalized_v2/R1_V2_CONFIG_SCHEMA.json); its content hash must equal result.configuration_hash."
          },
          "result": {
            "type": "object",
            "description": "urn:trustworthy:r1:v4:assessment:1.0.0 (evaluation/r1_v4/assessment.schema.json), unchanged; assessment_hash must match its content.",
            "required": ["requirement_id", "requirement_version", "checker_version", "configuration_hash", "assessment_manifest", "configuration_status", "assessed", "object_assessments", "execution_outcome", "physical_safety_conclusion", "empirical_profiles_enabled", "admitted_evidence_ids", "evidence_admission", "missing_requirements", "uncertainty", "provenance", "assessment_hash", "evidence_records", "synthetic", "validation_status"],
            "properties": {
              "requirement_id": {"const": "R1"},
              "requirement_version": {"const": "2.0.0"},
              "assessment_schema_version": {"const": "1.0.0"},
              "configuration_schema_version": {"const": "2.0.1"},
              "physical_safety_conclusion": {"const": false},
              "empirical_profiles_enabled": {"const": false},
              "configuration_status": {"const": "valid"},
              "assessed": {"const": true},
              "checker_version": {"type": "string"},
              "configuration_hash": {"type": "string"},
              "assessment_hash": {"type": "string"},
              "object_assessments": {
                "type": "array",
                "items": {"type": "object"},
                "description": "Each item follows object_assessments in urn:trustworthy:r1:v4:assessment:1.0.0 (evaluation/r1_v4/contracts.py:ObjectAssessment); checked field by field by the Critic."
              },
              "evidence_records": {"type": "array", "items": {"type": "object"}},
              "admitted_evidence_ids": {"type": "array", "items": {"type": "string"}},
              "provenance": {
                "type": "object",
                "required": ["execution_id", "task_id", "admitted_purpose"]
              },
              "synthetic": {"type": "boolean"}
            }
          }
        }
      }
    },
    "retrieval_context": {
      "description": "Section E. What was requested and returned; the package is not assumed to be the whole database.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_measurement_types", "complete_within_requested_scope", "gaps", "related_case_evidence_ids"],
      "properties": {
        "requested_measurement_types": {"type": "array", "items": {"type": "string"}},
        "complete_within_requested_scope": {"type": "boolean"},
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["object_id", "measurement_type", "interval"],
            "properties": {
              "object_id": {"type": "string"},
              "measurement_type": {"type": "string"},
              "interval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "reason": {"type": "string"}
            }
          }
        },
        "related_case_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
