{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustworthy:r1-v3-registry-record:2.0.0",
  "title": "R1 v3 evidence registry record",
  "description": "Source-bound saved-frame observations and provisional checker events. Registry metadata does not establish empirical admission.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/$defs/record_id"},
    "schema_version": {"const": "2.0.0"},
    "requirement_id": {"const": "R1"},
    "requirement_version": {"const": "r1-initial-table-support-v3-20261024"},
    "execution_id": {"$ref": "#/$defs/nonempty_string"},
    "task_id": {"$ref": "#/$defs/nonempty_string"},
    "object_id": {"$ref": "#/$defs/nonempty_string"},
    "kind": {"enum": ["raw_measurement", "derived_checker_event"]},
    "measurement_type": {"type": "string"},
    "validation_status": {"enum": ["verified_source", "provisional"]},
    "source": {"$ref": "#/$defs/source"},
    "trajectory_sha256": {"$ref": "#/$defs/sha256"},
    "domain": {"const": "frame"},
    "clock": {"const": "saved_frame_index"},
    "interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/nonnegative_integer"}
    },
    "saved_frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/saved_frame"}
    },
    "uncertainty": {"$ref": "#/$defs/unique_strings"},
    "limitations": {"$ref": "#/$defs/unique_strings"},
    "native_binding": {"$ref": "#/$defs/native_binding"},
    "checker": {"$ref": "#/$defs/checker"}
  },
  "required": [
    "id",
    "schema_version",
    "requirement_id",
    "requirement_version",
    "execution_id",
    "task_id",
    "object_id",
    "kind",
    "measurement_type",
    "validation_status",
    "source",
    "trajectory_sha256",
    "domain",
    "clock",
    "interval",
    "saved_frames",
    "uncertainty",
    "limitations"
  ],
  "oneOf": [
    {
      "properties": {
        "kind": {"const": "raw_measurement"},
        "measurement_type": {
          "enum": [
            "object_pose",
            "native_geometry",
            "contact",
            "camera_reference",
            "robot_state",
            "timestamp",
            "recorded_state"
          ]
        },
        "validation_status": {"const": "verified_source"},
        "saved_frames": {"items": {"required": ["selectors"]}}
      },
      "not": {"required": ["checker"]},
      "if": {"properties": {"measurement_type": {"enum": ["object_pose", "native_geometry", "contact"]}}},
      "then": {"required": ["native_binding"]}
    },
    {
      "properties": {
        "kind": {"const": "derived_checker_event"},
        "measurement_type": {"const": "checker_event"},
        "validation_status": {"const": "provisional"},
        "saved_frames": {
          "items": {
            "not": {"anyOf": [{"required": ["selectors"]}, {"required": ["simulator_time_seconds"]}]}
          }
        }
      },
      "required": ["checker"],
      "not": {"required": ["native_binding"]}
    }
  ],
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1},
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "absolute_path": {"type": "string", "pattern": "^/"},
    "selector": {"type": "string", "pattern": "^/.+"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_id": {"type": "string", "pattern": "^ev:[0-9a-f]{64}$"},
    "unique_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty_string"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"]
    },
    "saved_frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {"$ref": "#/$defs/nonnegative_integer"},
        "selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/selector"}
        },
        "simulator_time_seconds": {"type": "number"}
      },
      "required": ["frame"]
    },
    "native_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body_id": {"$ref": "#/$defs/nonnegative_integer"},
        "collision_geom_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "pose_phase": {"const": "native_last_forward_cache_uncalibrated_phase"},
        "simulator_xml": {"$ref": "#/$defs/source"},
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"$ref": "#/$defs/absolute_path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "selector": {"$ref": "#/$defs/selector"}
          },
          "required": ["path", "sha256", "selector"]
        }
      },
      "required": ["body_id", "collision_geom_ids", "pose_phase", "simulator_xml", "mapping"]
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"const": "r1-evidence-v3.0.0"},
        "config": {"$ref": "#/$defs/source"},
        "event_id": {"$ref": "#/$defs/nonempty_string"},
        "selector": {"type": "string", "pattern": "^/(0|[1-9][0-9]*)/events/(0|[1-9][0-9]*)$"},
        "input_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/record_id"}
        }
      },
      "required": ["version", "config", "event_id", "selector", "input_record_ids"]
    }
  }
}
